# Copie ce fichier en .env puis adapte.

# --- Adresse publique ---
# Local : ":80" (+ HTTP_PORT=8080 si le port 80 est pris, et BASE_URL=http://localhost:8080)
# Production : ton domaine, Caddy obtient le certificat HTTPS tout seul (ex. radio.mondomaine.fr)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
BASE_URL=http://localhost

# --- Secrets ---
SESSION_SECRET=une-longue-chaine-aleatoire
# Ne le change pas si le volume pgdata existe déjà (le mot de passe est figé à la création de la base)
POSTGRES_PASSWORD=radio

# --- Connexion ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails (séparés par des virgules) qui deviennent administrateurs à la connexion
ADMIN_EMAILS=admin@example.com
# Local uniquement, sans Google : permet de se connecter avec n'importe quel email. JAMAIS en production.
ALLOW_DEV_LOGIN=0

# --- Options ---
CHAT_ENABLED=1
# Après N morceaux validés (et aucun refusé), les suivants d'un utilisateur sont publiés directement. 0 = tout modérer.
AUTO_APPROVE_AFTER=3
# Adresse affichée pour les demandes de retrait de contenu
CONTACT_EMAIL=

